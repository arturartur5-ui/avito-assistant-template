# Обычный Авито: кабинет клиента -> «Для профессионалов» -> «API».
# Нужен платный тариф: «Базовый», «Расширенный» или «Максимальный».
# Значения копировать ТОЛЬКО кнопкой копирования: в шрифте Авито
# 1, l и I неразличимы, набирать руками нельзя.
# Вставлять в этот файл через редактор, а не через терминал —
# bash превращает стрелки в escape-последовательности и режет значения.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Необязательно: подставится само из профиля.
AVITO_USER_ID=

# Рекламный кабинет, если нужен: ads.avito.ru -> настройки -> API,
# роль Администратор.
AVITO_ADS_CLIENT_ID=
AVITO_ADS_CLIENT_SECRET=
AVITO_ADS_ACCOUNT_ID=

# Слова ниши: по ним из Telegram отбираются рабочие чаты.
# Подставьте свои — у каждой специальности они разные.
# Пример для ипотечного брокера:
TOPIC_KEYWORDS=ипотек,ставк,банк,первоначальн,одобрен,рефинанс,застройщик,кредитн,материнск,семейн,сделк
TOPIC_MIN_HITS=3

# Личные чаты, которые не брать в корпус: семья, друзья.
# Названия как в Telegram, через запятую. Это персональные данные —
# файл .env в репозиторий не попадает.
EXCLUDE_CHATS=

# --- Шлюз к языковой модели -------------------------------------------------
# Адрес шлюза со стороны российского сервера (обычно локальный конец туннеля).
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Ключ доступа К ШЛЮЗУ (или ключ провайдера, если ходите к нему напрямую). Ключей самих моделей на российском сервере нет.
LLM_API_KEY=
# Профиль или маршрут модели на шлюзе.
LLM_MODEL=
# Необязательно: несколько бэкендов через запятую для слепого сравнения на
# экзамене (LLM_MODELS=main,backup). Пусто — используется LLM_MODEL.
# LLM_MODELS=
# Необязательно: свой набор корневых сертификатов для api.avito.ru, если
# системный не подходит (путь к .pem). Обычно не нужно.
# AVITO_CA_BUNDLE=

# --- Этап 2: черновики на подтверждение (src/draft_loop.py) -----------------
# Куда слать черновики: id чата специалиста с тем же ботом. Узнать просто —
# специалист пишет боту, а в выводе тренировочного бота видно его chat_id.
DRAFT_OWNER_CHAT=
# Как часто заглядывать в чаты Авито, секунд.
DRAFT_POLL_SECONDS=60

# --- Выкладка промпта на шлюз (scripts/sync-prompt.sh) -----------------------
# Нужно только если системный промпт живёт на шлюзе, а не подаётся из кода.
# GATEWAY_HOST=user@host           # ssh-адрес шлюза или алиас из ~/.ssh/config
# GATEWAY_PROMPT_PATH=/path/to/SOUL.md
# GATEWAY_RESTART=systemctl restart my-gateway   # команда перезапуска на той стороне
# GATEWAY_OWNER=1000:1000          # необязательно: владелец файла на шлюзе

# --- Кто такой специалист ---------------------------------------------------
# Основы имени и фамилии владельца аккаунта через запятую: по ним помощник
# вычищает его имя из всего, что уходит наружу, и не говорит о себе в третьем
# лице. Пример: Ярополк,Ярик,Примеров
OWNER_NAME_FORMS=
# Род, в котором помощник говорит о себе: f — женский, m — мужской. Обязательно.
OWNER_GENDER=

# --- Тренировочный бот в Telegram (этап «экзамен») --------------------------
# Токен от @BotFather. Заводите отдельного бота, не рабочего.
TELEGRAM_BOT_TOKEN=
# Пароль на вход в тренировочного бота: /start ПАРОЛЬ. Обязателен, случайный,
# 16+ знаков. С образцовым значением ниже бот не запустится.
EXAM_PASSWORD=смените-меня
# Открыть бота всем, у кого есть ссылка, — только осознанно и с пустым паролем:
# посторонние увидят ответы специалиста и будут жечь квоту модели.
# EXAM_OPEN=1
# Сообщений в день на одного человека. Действует и с паролем: пароль могут
# переслать, а квота модели — ваша.
EXAM_DAILY_LIMIT=40
